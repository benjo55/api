<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestoreLockedMode>false</RestoreLockedMode>
    <UseAppHost Condition="'$(Configuration)' == 'Debug'">false</UseAppHost>

    <!-- Exclusions evaluated before SDK globs scan the project tree -->
    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      api.Tests\**;
      publish\**;
      publish*\**;
      node_modules\**;
      **\bin\**;
      **\bin-*\**;
      **\obj\**;
      **\obj-*\**;
      **\TestResults\**;
      **\coverage\**;
      **\artifacts\**
    </DefaultItemExcludes>

    <DefaultItemExcludesInProjectFolder>
      $(DefaultItemExcludesInProjectFolder);
      api.Tests\**;
      publish\**;
      publish*\**;
      node_modules\**;
      **\bin\**;
      **\bin-*\**;
      **\obj\**;
      **\obj-*\**;
      **\TestResults\**;
      **\coverage\**;
      **\artifacts\**
    </DefaultItemExcludesInProjectFolder>
    <UserSecretsId>45bceaf8-01ba-48c5-8d26-68c67ffe5b1a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mapster" Version="7.4.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Cronos" Version="0.11.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="9.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.57.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SqlServer.Server" Version="1.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Quartz" Version="3.9.0" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.9.0" />
    <PackageReference Include="Quartz.Serialization.Json" Version="3.9.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="QuestPDF" Version="2025.1.4" />
    <PackageReference Include="PdfPig" Version="0.1.12" />
    <PackageReference Include="PdfSharp" Version="6.1.1" />
    <PackageReference Include="Scrutor" Version="6.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="YahooFinanceApi" Version="2.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\APICIL_EPARGNE.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LogoSSBD.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Templates\TaxReceipts\**\*.pdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Templates\TaxReceipts\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="InstallPlaywrightBrowsers" AfterTargets="Publish">
    <Exec WorkingDirectory="$(PublishDir)" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(PublishDir)playwright.ps1&quot; install chromium" EnvironmentVariables="PLAYWRIGHT_BROWSERS_PATH=0;NODE_OPTIONS=--use-system-ca" />
  </Target>

</Project>
